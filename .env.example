# App Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careercraft?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate with `openssl rand -base64 32`)
JWT_ACCESS_SECRET=super-secret-access-token-key-change-me-in-production-32char
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-me-in-production-32char
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email / Nodemailer (Mailpit / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CareerCraft <no-reply@careercraft.local>"

# S3-Compatible Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careercraft-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# OAuth Credentials (Optional in local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Provider (Phase 5)
ANTHROPIC_API_KEY=
