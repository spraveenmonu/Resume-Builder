datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum JobStatus {
  SAVED
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum DownloadFormat {
  PDF
  DOCX
  TXT
  PNG
  JSON
}

enum AiGenerationType {
  SUMMARY
  BULLETS
  SKILLS
  ATS_CHECK
  TAILOR
  TONE
  GRAMMAR
  TRANSLATION
  INTERVIEW_PREP
  HEADLINE
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  ADDRESSED
  CLOSED
}

// -------------------------------------------------------------
// 1. User & Authentication
// -------------------------------------------------------------
model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  passwordHash          String?
  name                  String
  avatarUrl             String?
  role                  Role            @default(USER)
  isEmailVerified       Boolean         @default(false)
  emailVerifiedAt       DateTime?
  
  // Two-Factor Authentication (TOTP)
  totpEnabled           Boolean         @default(false)
  totpSecret            String?
  totpBackupCodes       String[]        @default([])
  
  // Brute-force protection & security
  failedLoginAttempts   Int             @default(0)
  lockedUntil           DateTime?
  
  // Soft delete (Account deletion with 7-day grace period purge)
  deletedAt             DateTime?
  scheduledPurgeAt      DateTime?
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relationships
  sessions              Session[]
  oauthAccounts         OAuthAccount[]
  emailVerifications    EmailVerificationToken[]
  passwordResets        PasswordResetToken[]
  resumes               Resume[]
  coverLetters          CoverLetter[]
  stylePresets          StylePreset[]
  jobApplications       JobApplication[]
  reminders             Reminder[]
  downloads             Download[]
  aiGenerations         AiGeneration[]
  feedbacks             Feedback[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String    // Refresh token rotation family ID
  userAgent        String?
  ipAddress        String?
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  isRevoked        Boolean   @default(false)
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// -------------------------------------------------------------
// 2. Resumes, Versions, & Styles
// -------------------------------------------------------------
model Resume {
  id             String          @id @default(cuid())
  userId         String
  title          String          @default("Untitled Resume")
  slug           String          @unique
  templateId     String          @default("classic-professional")
  schemaVersion  String          @default("1.0.0")
  
  // The complete resume JSON payload (personal, summary, sections, style)
  data           Json
  
  isAtsMode      Boolean         @default(false)
  isArchived     Boolean         @default(false)
  deletedAt      DateTime?       // 30-day trash window

  // Sharing & public view options
  isPublic       Boolean         @default(false)
  sharePassword  String?
  shareExpiresAt DateTime?
  hidePhone      Boolean         @default(false)
  hideEmail      Boolean         @default(false)
  allowDownload  Boolean         @default(true)
  viewCount      Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       Template        @relation(fields: [templateId], references: [slug])
  versions       ResumeVersion[]
  coverLetters   CoverLetter[]
  jobApplications JobApplication[]
  downloads      Download[]
  aiGenerations  AiGeneration[]
  reviews        ResumeReview[]

  @@index([userId])
  @@index([updatedAt])
  @@index([slug])
  @@index([isArchived, deletedAt])
}

model ResumeVersion {
  id            String    @id @default(cuid())
  resumeId      String
  versionNumber Int
  name          String?
  data          Json
  changeSummary String?
  createdAt     DateTime  @default(now())

  resume        Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
  @@index([createdAt])
}

model Template {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  category      String    // ats, modern, specialized
  description   String
  previewImage  String
  atsSafe       Boolean   @default(false)
  supportsPhoto Boolean   @default(true)
  columns       Int       @default(1)
  layoutConfig  Json      // Default margins, default columns ratio
  defaultStyle  Json      // Default CSS token values
  sampleData    Json      // Starter preview content
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  resumes       Resume[]

  @@index([category])
  @@index([atsSafe])
  @@index([isActive])
}

model StylePreset {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  category    String   // typography, color-palette, layout, complete
  isSystem    Boolean  @default(false)
  style       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isSystem])
}

// -------------------------------------------------------------
// 3. Cover Letters & Templates
// -------------------------------------------------------------
model CoverLetter {
  id             String                @id @default(cuid())
  userId         String
  resumeId       String?
  templateId     String                @default("general")
  title          String                @default("Untitled Cover Letter")
  jobTitle       String?
  companyName    String?
  hiringManager  String?
  content        String                @db.Text
  style          Json
  deletedAt      DateTime?             // 30-day trash window
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?               @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  template       CoverLetterTemplate   @relation(fields: [templateId], references: [slug])
  jobApplications JobApplication[]
  downloads      Download[]

  @@index([userId])
  @@index([updatedAt])
  @@index([deletedAt])
}

model CoverLetterTemplate {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  category        String
  description     String
  contentTemplate String        @db.Text
  defaultTone     String        @default("professional")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  coverLetters    CoverLetter[]

  @@index([category])
}

// -------------------------------------------------------------
// 4. Job Application Tracker & Reminders
// -------------------------------------------------------------
model JobApplication {
  id             String             @id @default(cuid())
  userId         String
  resumeId       String?
  coverLetterId  String?
  company        String
  title          String
  jobUrl         String?
  location       String?
  workType       String?
  status         JobStatus          @default(SAVED)
  salaryMin      Int?
  salaryMax      Int?
  currency       String             @default("USD")
  appliedAt      DateTime?
  notes          String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter    CoverLetter?       @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  events         ApplicationEvent[]
  reminders      Reminder[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model ApplicationEvent {
  id             String         @id @default(cuid())
  applicationId  String
  type           String
  scheduledAt    DateTime
  locationOrUrl  String?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([scheduledAt])
}

model Reminder {
  id             String          @id @default(cuid())
  userId         String
  applicationId  String?
  title          String
  dueAt          DateTime
  isCompleted    Boolean         @default(false)
  emailSent      Boolean         @default(false)
  type           String          @default("FOLLOW_UP")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueAt, isCompleted])
}

// -------------------------------------------------------------
// 5. Downloads, AI Tracking, Feedback, & Reviews
// -------------------------------------------------------------
model Download {
  id            String         @id @default(cuid())
  userId        String?
  resumeId      String?
  coverLetterId String?
  format        DownloadFormat
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  resume        Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter   CoverLetter?   @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resumeId])
  @@index([createdAt])
}

model AiGeneration {
  id           String           @id @default(cuid())
  userId       String
  resumeId     String?
  type         AiGenerationType
  inputPrompt  String           @db.Text
  outputContent String          @db.Text
  model        String           @default("claude-3-5-sonnet")
  inputTokens  Int              @default(0)
  outputTokens Int              @default(0)
  costCents    Float            @default(0.0)
  latencyMs    Int              @default(0)
  createdAt    DateTime         @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume       Resume?          @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String
  rating    Int
  category  String
  message   String         @db.Text
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ResumeReview {
  id             String    @id @default(cuid())
  resumeId       String
  reviewerEmail  String
  status         String    @default("PENDING")
  reviewNotes    String?   @db.Text
  sectionComments Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resume         Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([reviewerEmail])
}

// -------------------------------------------------------------
// 6. Admin, System, Moderation, & Audit
// -------------------------------------------------------------
model Report {
  id          String       @id @default(cuid())
  reporterId  String?
  targetType  String
  targetId    String
  reason      String
  details     String?      @db.Text
  status      ReportStatus @default(PENDING)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([targetType, targetId])
  @@index([status])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  message   String    @db.Text
  badge     String?
  linkUrl   String?
  isActive  Boolean   @default(true)
  startAt   DateTime  @default(now())
  endAt     DateTime?
  createdAt DateTime  @default(now())

  @@index([isActive])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
